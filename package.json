{
  "name": "garbage-unstop-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:import-wards": "tsx scripts/import-wards.ts --file data/delhi_wards.json --id-prop ward_id --name-prop ward_name",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:int": "vitest run --config vitest.int.config.ts",
    "profile": "tsx scripts/profile_grievances.ts",
    "gen:10k": "tsx scripts/generate_synthetic_10k.ts",
    "gen:10k:dry": "tsx scripts/generate_synthetic_10k.ts --dry-run",
    "backtest": "tsx scripts/backtest_early_warning.ts",
    "probe:llm": "tsx scripts/probe_llm_models.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.4.1",
    "@langchain/openai": "^1.8.4",
    "@prisma/client": "^6.19.3",
    "@turf/turf": "^7.4.0",
    "leaflet": "^1.9.4",
    "next": "^16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}