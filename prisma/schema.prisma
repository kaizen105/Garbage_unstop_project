datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  DRIVER
  DISPATCHER
  ADMIN
}

enum HazardCategory {
  biohazard_medical
  construction_debris
  electrical_hazard
  chemical
  general_overflow
  unknown
}

enum ReportStatus {
  OPEN
  DISPATCHED
  RESOLVED
}

enum ActionRequired {
  dispatch_hazmat_bypass_standard
  bypass_standard
  routine_collection
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  role      Role     @default(DRIVER)
  wardId    String?
  ward      Ward?    @relation(fields: [wardId], references: [id])
  reports   Report[]
  createdAt DateTime @default(now())
}

model Ward {
  id           String                                  @id @default(cuid())
  externalId   String                                  @unique
  name         String
  sourceWardId String?
  geom       Unsupported("geometry(MultiPolygon, 4326)")?
  users      User[]
  reports    Report[]
  audits     AuditRun[]

  @@index([geom], type: Gist, map: "ward_geom_gist")
}

model Report {
  id                    String         @id
  hazardCategory        HazardCategory
  severityLevel         Int
  rawLocation           String
  lat                   Float?
  lng                   Float?
  transcript            String
  transcriptMock        Boolean        @default(false)
  translatedEnglish     String?
  actionRequired        ActionRequired
  status                ReportStatus   @default(OPEN)
  estimatedPreventedInr Int?
  isSynthetic           Boolean        @default(false)
  reporterId            String?
  reporter              User?          @relation(fields: [reporterId], references: [id])
  wardId                String?
  ward                  Ward?          @relation(fields: [wardId], references: [id])
  createdAt             DateTime       @default(now())
  resolvedAt            DateTime?

  @@index([wardId, createdAt])
}

model AuditRun {
  id              String   @id @default(cuid())
  wardId          String?
  ward            Ward?    @relation(fields: [wardId], references: [id])
  weekStart       DateTime
  dominantAnomaly String
  rootCause       String
  recommendation  String
  createdAt       DateTime @default(now())
}


model MitigationPlan {
  id                String   @id @default(cuid())
  windowStart       DateTime
  windowEnd         DateTime
  model             String
  includesSynthetic Boolean
  aggregatesJson    Json
  planJson          Json
  createdAt         DateTime @default(now())
}
